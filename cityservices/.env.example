SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
SECURE_SSL_REDIRECT=False
REDIS_URL=redis://127.0.0.1:6379/1

# Email: console backend is recommended for local development.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=no-reply@example.com

# Required only when Razorpay payments are enabled.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Vercel production: use a managed PostgreSQL connection string and an S3-compatible bucket.
# Set these in Vercel Project Settings > Environment Variables, not in this file.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# SECRET_KEY=generate-a-long-random-production-secret
# DEBUG=False
# ALLOWED_HOSTS=.vercel.app,your-custom-domain.example
# CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://your-custom-domain.example
# AWS_STORAGE_BUCKET_NAME=your-private-media-bucket
# AWS_S3_REGION_NAME=your-bucket-region
# AWS_S3_ENDPOINT_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=