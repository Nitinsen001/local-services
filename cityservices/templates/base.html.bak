{% load static %}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Local Services Marketplace{% endblock %}</title>
    {% if user.is_authenticated %}<link rel="stylesheet" href="{% static 'css/style.css' %}">{% endif %}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', 'Segoe UI', system-ui, -apple-system, sans-serif;
            background: linear-gradient(135deg, #e0f7ff 0%, #ffffff 50%, #cfe9ff 100%);
            min-height: 100vh;
            position: relative;
            overflow-x: hidden;
            color: #1e293b;
        }

        /* Animated gradient background */
        body::before {
            content: '';
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: 
                radial-gradient(circle at 20% 30%, rgba(56, 189, 248, 0.15) 0%, transparent 50%),
                radial-gradient(circle at 80% 70%, rgba(14, 165, 233, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 50% 50%, rgba(125, 211, 252, 0.1) 0%, transparent 50%);
            z-index: 0;
            animation: gradientShift 15s ease infinite;
        }

        @keyframes gradientShift {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }

        /* Decorative floating elements */
        .bg-circle {
            position: fixed;
            border-radius: 50%;
            filter: blur(100px);
            z-index: 0;
            animation: float 20s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translate(0, 0) scale(1); }
            33% { transform: translate(30px, -30px) scale(1.1); }
            66% { transform: translate(-20px, 20px) scale(0.9); }
        }

        .circle-1 {
            width: 500px;
            height: 500px;
            background: rgba(56, 189, 248, 0.2);
            top: -150px;
            left: -150px;
            animation-delay: 0s;
        }

        .circle-2 {
            width: 600px;
            height: 600px;
            background: rgba(14, 165, 233, 0.15);
            bottom: -200px;
            right: -200px;
            animation-delay: 5s;
        }

        .circle-3 {
            width: 400px;
            height: 400px;
            background: rgba(125, 211, 252, 0.2);
            top: 40%;
            right: 10%;
            animation-delay: 10s;
        }

        .container {
            position: relative;
            z-index: 1;
            padding: 20px;
            max-width: 1400px;
            margin: 0 auto;
        }

        /* Header with glassmorphism */
        .header {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            border-radius: 20px;
            padding: 20px 40px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
            box-shadow: 0 20px 60px rgba(14, 165, 233, 0.15);
            transition: all 0.3s ease;
        }

        .header:hover {
            box-shadow: 0 25px 70px rgba(14, 165, 233, 0.2);
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 22px;
            font-weight: 700;
            color: #0c4a6e;
            letter-spacing: -0.5px;
        }

        .logo a {
            text-decoration: none;
            color: inherit;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .logo-icon {
            width: 45px;
            height: 45px;
            background: linear-gradient(135deg, #0ea5e9 0%, #38bdf8 100%);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 20px;
            box-shadow: 0 8px 20px rgba(14, 165, 233, 0.4);
            animation: pulse 3s ease-in-out infinite;
        }

        @keyframes pulse {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.05); }
        }

        .nav-links {
            display: flex;
            align-items: center;
            gap: 35px;
        }

        .nav-links a {
            text-decoration: none;
            color: #475569;
            font-weight: 500;
            font-size: 15px;
            transition: all 0.3s ease;
            position: relative;
            padding: 5px 0;
        }

        .nav-links a::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0;
            height: 2px;
            background: linear-gradient(90deg, #0ea5e9, #38bdf8);
            transition: width 0.3s ease;
        }

        .nav-links a:hover {
            color: #0c4a6e;
        }

        .nav-links a:hover::after {
            width: 100%;
        }

        .nav-links .active {
            color: #0c4a6e;
            font-weight: 600;
        }

        .nav-links .active::after {
            width: 100%;
        }

        .user-actions {
            display: flex;
            align-items: center;
            gap: 15px;
        }

        .notification {
            position: relative;
            padding: 10px;
            border-radius: 10px;
            background: rgba(14, 165, 233, 0.1);
            border: 1px solid rgba(14, 165, 233, 0.2);
            cursor: pointer;
            transition: all 0.3s ease;
            color: #0c4a6e;
        }

        .notification:hover {
            background: rgba(14, 165, 233, 0.2);
            transform: translateY(-2px);
        }

        .notification-badge {
            position: absolute;
            top: 5px;
            right: 5px;
            width: 8px;
            height: 8px;
            background: #ef4444;
            border-radius: 50%;
            box-shadow: 0 0 10px rgba(239, 68, 68, 0.6);
        }

        /* Main Content */
        .main-content {
            display: grid;
            grid-template-columns: 1fr 400px;
            gap: 30px;
            margin-bottom: 30px;
        }

        .left-panel {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            border-radius: 24px;
            padding: 35px;
            box-shadow: 0 20px 60px rgba(14, 165, 233, 0.15);
        }

        /* Search Section */
        .search-section {
            margin-bottom: 35px;
        }

        .search-box {
            position: relative;
            margin-bottom: 25px;
        }

        .search-input {
            width: 100%;
            padding: 18px 24px;
            background: rgba(255, 255, 255, 0.6);
            border: 2px solid rgba(14, 165, 233, 0.2);
            border-radius: 16px;
            font-size: 16px;
            color: #1e293b;
            outline: none;
            transition: all 0.3s ease;
        }

        .search-input::placeholder {
            color: #64748b;
        }

        .search-input:focus {
            background: rgba(255, 255, 255, 0.9);
            border-color: #0ea5e9;
            box-shadow: 0 0 0 4px rgba(14, 165, 233, 0.1);
        }

        .search-btn {
            position: absolute;
            right: 8px;
            top: 50%;
            transform: translateY(-50%);
            background: linear-gradient(135deg, #0ea5e9 0%, #38bdf8 100%);
            color: white;
            border: none;
            padding: 10px 24px;
            border-radius: 12px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(14, 165, 233, 0.3);
        }

        .search-btn:hover {
            transform: translateY(-50%) scale(1.05);
            box-shadow: 0 6px 20px rgba(14, 165, 233, 0.4);
        }

        .nav-tabs {
            display: flex;
            gap: 25px;
            margin-bottom: 35px;
            overflow-x: auto;
            padding-bottom: 5px;
        }

        .nav-tab {
            color: #64748b;
            text-decoration: none;
            font-weight: 500;
            padding: 8px 20px;
            border-radius: 10px;
            background: rgba(14, 165, 233, 0.05);
            border: 1px solid rgba(14, 165, 233, 0.1);
            transition: all 0.3s ease;
            white-space: nowrap;
        }

        .nav-tab.active {
            color: #fff;
            background: linear-gradient(135deg, #0ea5e9 0%, #38bdf8 100%);
            border-color: transparent;
            box-shadow: 0 4px 15px rgba(14, 165, 233, 0.3);
        }

        .nav-tab:hover {
            background: rgba(14, 165, 233, 0.15);
            color: #0c4a6e;
        }

        /* Featured Services */
        .featured-services {
            margin-bottom: 35px;
        }

        .section-title {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .section-title h2 {
            font-size: 26px;
            color: #0c4a6e;
            font-weight: 700;
            letter-spacing: -0.5px;
        }

        .view-all {
            color: #0ea5e9;
            text-decoration: none;
            font-weight: 600;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .view-all:hover {
            color: #0284c7;
            transform: translateX(5px);
        }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 20px;
            margin-bottom: 35px;
        }

        .service-card {
            position: relative;
            border-radius: 20px;
            overflow: hidden;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            background: rgba(255, 255, 255, 0.9);
            border: 1px solid rgba(14, 165, 233, 0.2);
            box-shadow: 0 10px 30px rgba(14, 165, 233, 0.15);
        }

        .service-card:hover {
            transform: translateY(-10px) scale(1.02);
            box-shadow: 0 20px 50px rgba(14, 165, 233, 0.3);
            border-color: #0ea5e9;
        }

        .service-card img {
            width: 100%;
            height: 220px;
            object-fit: cover;
            transition: transform 0.4s ease;
        }

        .service-card:hover img {
            transform: scale(1.1);
        }

        .service-badge {
            position: absolute;
            top: 15px;
            left: 15px;
            background: linear-gradient(135deg, #0ea5e9 0%, #38bdf8 100%);
            backdrop-filter: blur(10px);
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 11px;
            font-weight: 700;
            color: #fff;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            box-shadow: 0 4px 15px rgba(14, 165, 233, 0.4);
        }

        .service-rating {
            position: absolute;
            bottom: 15px;
            left: 355px;
            display: flex;
            align-items: center;
            gap: 5px;
            color: #fbbf24;
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            padding: 6px 10px;
            border-radius: 8px;
            font-size: 13px;
            font-weight: 600;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .service-info {
            position: absolute;
            bottom: 0;
            left: 0;
            right: 0;
            background: linear-gradient(to top, rgba(12, 74, 110, 0.95), transparent);
            padding: 50px 15px 15px;
            color: white;
        }

        .service-name {
            font-weight: 700;
            margin-bottom: 5px;
            font-size: 16px;
        }

        .service-area {
            font-size: 13px;
            opacity: 0.9;
            color: #e0f2fe;
        }

        /* Service Categories */
        .service-categories {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
            gap: 15px;
            margin-bottom: 35px;
        }

        .category-item {
            text-align: center;
            padding: 25px 15px;
            background: rgba(255, 255, 255, 0.6);
            border: 1px solid rgba(14, 165, 233, 0.2);
            border-radius: 16px;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .category-item:hover {
            background: linear-gradient(135deg, rgba(14, 165, 233, 0.1), rgba(56, 189, 248, 0.1));
            border-color: #0ea5e9;
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(14, 165, 233, 0.2);
        }

        .category-icon {
            width: 50px;
            height: 50px;
            margin: 0 auto 12px;
            background: linear-gradient(135deg, #0ea5e9 0%, #38bdf8 100%);
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 22px;
            box-shadow: 0 8px 20px rgba(14, 165, 233, 0.3);
        }

        .category-name {
            font-size: 13px;
            font-weight: 600;
            color: #0c4a6e;
        }

        /* Search Results */
        .search-results h3 {
            margin-bottom: 25px;
            color: #0c4a6e;
            font-size: 22px;
            font-weight: 700;
        }

        .provider-list {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .provider-card {
            display: flex;
            align-items: center;
            padding: 20px;
            background: rgba(255, 255, 255, 0.6);
            border: 1px solid rgba(14, 165, 233, 0.2);
            border-radius: 16px;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .provider-card:hover {
            background: rgba(255, 255, 255, 0.9);
            border-color: #0ea5e9;
            transform: translateX(8px);
            box-shadow: 0 10px 30px rgba(14, 165, 233, 0.2);
        }

        .provider-avatar {
            width: 55px;
            height: 55px;
            border-radius: 50%;
            object-fit: cover;
            margin-right: 18px;
            border: 3px solid #0ea5e9;
            box-shadow: 0 4px 15px rgba(14, 165, 233, 0.3);
        }

        .provider-info {
            flex: 1;
        }

        .provider-name {
            font-weight: 700;
            margin-bottom: 6px;
            color: #0c4a6e;
            font-size: 16px;
        }

        .provider-service {
            font-size: 13px;
            color: #64748b;
        }

        .provider-actions {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .price-tag {
            background: rgba(16, 185, 129, 0.15);
            border: 1px solid rgba(16, 185, 129, 0.3);
            color: #059669;
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 600;
        }

        .book-btn {
            background: linear-gradient(135deg, #0ea5e9 0%, #38bdf8 100%);
            color: white;
            border: none;
            padding: 10px 20px;
            border-radius: 10px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(14, 165, 233, 0.3);
        }

        .book-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(14, 165, 233, 0.4);
        }

        /* Right Panel */
        .right-panel {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            border-radius: 24px;
            padding: 35px;
            box-shadow: 0 20px 60px rgba(14, 165, 233, 0.15);
            height: fit-content;
            position: sticky;
            top: 20px;
        }

        .profile-header {
            text-align: center;
            margin-bottom: 30px;
        }

        .profile-avatar {
            width: 90px;
            height: 90px;
            border-radius: 50%;
            object-fit: cover;
            margin: 0 auto 15px;
            border: 4px solid #0ea5e9;
            box-shadow: 0 8px 25px rgba(14, 165, 233, 0.3);
        }

        .profile-name {
            font-size: 22px;
            font-weight: 700;
            margin-bottom: 6px;
            color: #0c4a6e;
        }

        .profile-title {
            color: #64748b;
            font-size: 14px;
            margin-bottom: 12px;
        }

        .profile-rating {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 5px;
            margin-top: 12px;
            color: #fbbf24;
        }

        .section {
            margin-bottom: 30px;
        }

        .section h4 {
            margin-bottom: 18px;
            color: #0c4a6e;
            font-size: 18px;
            font-weight: 700;
        }

        .portfolio-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 12px;
            margin-bottom: 18px;
        }

        .portfolio-item {
            aspect-ratio: 1;
            background: rgba(255, 255, 255, 0.6);
            border: 1px solid rgba(14, 165, 233, 0.2);
            border-radius: 12px;
            overflow: hidden;
            transition: all 0.3s ease;
            cursor: pointer;
        }

        .portfolio-item:hover {
            transform: scale(1.05);
            border-color: #0ea5e9;
            box-shadow: 0 8px 25px rgba(14, 165, 233, 0.3);
        }

        .portfolio-item img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .booking-btn {
            width: 100%;
            background: linear-gradient(135deg, #0ea5e9 0%, #38bdf8 100%);
            color: white;
            border: none;
            padding: 16px;
            border-radius: 14px;
            cursor: pointer;
            font-weight: 700;
            font-size: 16px;
            transition: all 0.3s ease;
            box-shadow: 0 8px 25px rgba(14, 165, 233, 0.3);
        }

        .booking-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 35px rgba(14, 165, 233, 0.4);
        }

        /* Calendar */
        .calendar {
            background: rgba(255, 255, 255, 0.6);
            border: 1px solid rgba(14, 165, 233, 0.2);
            border-radius: 16px;
            padding: 20px;
        }

        .calendar-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            color: #0c4a6e;
            font-weight: 600;
        }

        .calendar-header button {
            background: rgba(14, 165, 233, 0.1);
            border: 1px solid rgba(14, 165, 233, 0.2);
            color: #0c4a6e;
            padding: 6px 10px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .calendar-header button:hover {
            background: rgba(14, 165, 233, 0.2);
            border-color: #0ea5e9;
        }

        .calendar-grid {
            display: grid;
            grid-template-columns: repeat(7, 1fr);
            gap: 6px;
            text-align: center;
        }

        .calendar-day {
            padding: 10px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 13px;
            color: #64748b;
            font-weight: 500;
        }

        .calendar-day:hover {
            background: rgba(14, 165, 233, 0.15);
            color: #0c4a6e;
        }

        .calendar-day.available {
            background: rgba(16, 185, 129, 0.15);
            color: #059669;
            border: 1px solid rgba(16, 185, 129, 0.3);
        }

        /* Footer */
        .footer {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.5);
            border-radius: 24px;
            padding: 40px;
            box-shadow: 0 20px 60px rgba(14, 165, 233, 0.15);
            margin-top: 30px;
        }

        .footer-content {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 40px;
        }

        .footer-column h3 {
            margin-bottom: 20px;
            color: #0c4a6e;
            font-size: 18px;
            font-weight: 700;
        }

        .footer-column ul {
            list-style: none;
        }

        .footer-column ul li {
            margin-bottom: 12px;
        }

        .footer-column ul li a {
            text-decoration: none;
            color: #64748b;
            transition: all 0.3s ease;
            font-size: 14px;
        }

        .footer-column ul li a:hover {
            color: #0ea5e9;
            padding-left: 5px;
        }

        .footer-bottom {
            margin-top: 35px;
            padding-top: 25px;
            border-top: 1px solid rgba(14, 165, 233, 0.2);
            text-align: center;
            color: #64748b;
            font-size: 14px;
        }

        /* Responsive Design */
        @media (max-width: 1024px) {
            .main-content {
                grid-template-columns: 1fr;
            }

            .right-panel {
                position: relative;
                top: 0;
            }

            .services-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .service-categories {
                grid-template-columns: repeat(3, 1fr);
            }

            .header {
                padding: 20px;
                flex-direction: column;
                gap: 20px;
            }

            .nav-links {
                order: 3;
                flex-wrap: wrap;
                justify-content: center;
            }

            .footer-content {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @media (max-width: 768px) {
            .services-grid {
                grid-template-columns: 1fr;
            }

            .service-categories {
                grid-template-columns: repeat(2, 1fr);
            }

            .footer-content {
                grid-template-columns: 1fr;
            }

            .container {
                padding: 15px;
            }

            .left-panel, .right-panel {
                padding: 25px;
            }
        }

        /* Smooth animations */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(40px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .service-card, .provider-card, .category-item {
            animation: fadeInUp 0.6s ease forwards;
            opacity: 0;
        }

        .service-card:nth-child(1) { animation-delay: 0.05s; }
        .service-card:nth-child(2) { animation-delay: 0.1s; }
        .service-card:nth-child(3) { animation-delay: 0.15s; }
        .service-card:nth-child(4) { animation-delay: 0.2s; }
        .service-card:nth-child(5) { animation-delay: 0.25s; }
        .service-card:nth-child(6) { animation-delay: 0.3s; }
    </style>
</head>
<body>
    {% block content %}{% endblock %}
</body>
</html>